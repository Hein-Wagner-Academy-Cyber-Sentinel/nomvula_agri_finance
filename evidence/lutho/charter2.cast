[126.086407, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 7.2                                           charter.md                                                     \u001b[1;119H\u001b(B\u001b[m\r\u001b[29d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[29;16H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[29;61H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\r\u001b[30d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[30;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy"]
[126.086818, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Project Charter — \u001b(B\u001b[0m\u001b[36m<Persona name>\r\u001b[4d\u001b[32m_Complete this in Phase 1._\r\u001b[6d\u001b(B\u001b[0;1m\u001b[33m## Scope\r\u001b[7d\u001b(B\u001b[0m\u001b[32m_What this platform will and will not do._\r\u001b[9d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mDevelopment of infrastructure as code using OpenTofu and Bicep.\r\u001b[10d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mLocal emulation and validation workflows (Moto, Docker, GitHub Actions).\r\u001b[11d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mEndpoint hardening and security baseline definitions for rural branch workstations.\r\u001b[12d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mThreat modeling (v0 to v3) targeting offline sync, data tampering, and endpoint theft.\r\u001b[13d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mLocal AI feature modeling (e.g., credit fraud detection / anomaly detection).\r\u001b[14d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[m100% text-native evidence logging (asciinema session casts, scanner output files, pipeline logs).\r\u001b[16d"]
[126.087136, "o", "\u001b(B\u001b[0;1m\u001b[33m## Success criteria\r\u001b[17d\u001b(B\u001b[0m\u001b[32m_How we will know the platform is good enough._\r\u001b[19d\u001b(B\u001b[0;1m\u001b[33m## Assumptions\r\u001b[20d\u001b(B\u001b[0m\u001b[32m_What we are taking as given._\r\u001b[22d\u001b(B\u001b[0;1m\u001b[33m## Out of scope\r\u001b[23d\u001b(B\u001b[0m\u001b[32m_What we are deliberately not doing this year._\r\u001b[25d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mProvisioning funded/metered live public cloud accounts during development.\r\u001b[26d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mGUI-based console administration.\r\u001b[27d\u001b(B\u001b[0;1m\u001b[35m- \u001b[39m\u001b(B\u001b[mFull production deployment of external proprietary banking core mainframes.\r\u001b[2d\u001b[?12l\u001b[?25h"]
