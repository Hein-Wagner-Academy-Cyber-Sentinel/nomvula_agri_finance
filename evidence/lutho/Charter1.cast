[737.786047, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Project Charter — \u001b(B\u001b[0m\u001b[36m<Persona name>\r\u001b[4d\u001b[32m_Complete this in Phase 1._\r\u001b[6d\u001b(B\u001b[0;1m\u001b[33m## Scope\r\u001b[7d\u001b(B\u001b[0m\u001b[32m_What this platform will and will not do._\r\u001b[9d\u001b(B\u001b[0;1m\u001b[33m## Success criteria\r\u001b[10d\u001b(B\u001b[0m\u001b[32m_How we will know the platform is good enough._\r\u001b[12d\u001b(B\u001b[0;1m\u001b[33m## Assumptions\r\u001b[13d\u001b(B\u001b[0m\u001b[32m_What we are taking as given._\r\u001b[15d\u001b(B\u001b[0;1m\u001b[33m## Out of scope\r\u001b[16d\u001b(B\u001b[0m\u001b[32m_What we are deliberately not doing this year._\r\u001b[18d\u001b(B\u001b[0;1m\u001b[35m* \u001b[39m\u001b(B\u001b[mProvisioning funded/metered live public cloud accounts during development.\r\u001b[19d\u001b(B\u001b[0;1m\u001b[35m* \u001b[39m\u001b(B\u001b[mGUI-based console administration.\r\u001b[20d\u001b(B\u001b[0;1m\u001b[35m* \u001b[39m\u001b(B\u001b[mFull production deployment of external proprietary banking core mainframes.\r\u001b[21d\u001b(B\u001b[0;1m\u001b[35m* \u001b[39m\u001b(B\u001b[mNon-accessible visual evidence formats (screenshots are strictly excluded).\r\u001b[43d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[43;18H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out     \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is\u001b[52G\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[43;69H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute\u001b[86G\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location\u001b[103G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[43;120H\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark     \u001b(B\u001b[0;7mM-]\u001b(B\u001b[m To Bracket\r\u001b[44d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[44;18H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File     \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[52G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[44;69H\u001b(B\u001b[0;7m^J\u001b(B\