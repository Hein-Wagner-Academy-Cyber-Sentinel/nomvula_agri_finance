[620.341032, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 7.2           README.md                    \u001b[1;53H\u001b(B\u001b[m"]
[620.341488, "o", "\r\u001b[29d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[14G\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is  \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\r\u001b[30d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[14G\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace   \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste"]
[620.341884, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Build It Anywhere — Pair Project Repository\r\u001b[4d\u001b[32m**Cyber Sentinel Programme, Cohort 3, Year 2 — Hein W\u001b[39m\u001b(B\u001b[0;7m>\u001b[6;1H"]
[620.342237, "o", "\u001b(B\u001b[mThis is your pair's project repository for the whole \u001b(B\u001b[0;7m>\u001b[8;1H\u001b(B\u001b[mReplace the placeholders below in your first Friday (\u001b(B\u001b[0;7m>\u001b[10;1H\u001b(B\u001b[0;1m\u001b[33m---\r\u001b[12d## Our pair\r\u001b[14d\u001b[35m- \u001b[32m**Persona:**\u001b[39m\u001b(B\u001b[m Nomvula Agri Finance\r\u001b[15d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**Student A:**\u001b[39m\u001b(B\u001b[m Lutho\r\u001b[16d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**Student B:**\u001b[39m\u001b(B\u001b[m Mickeal\r\u001b[17d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**The platform in one paragraph:**\u001b[39m\u001b(B\u001b[m \u001b[32m_(write this in \u001b[39m\u001b(B\u001b[0;7m>\u001b[19;1H\u001b(B\u001b[0;1m\u001b[33m## How this repository is organised\r\u001b[21d\u001b[39m\u001b(B\u001b[mEvery folder has its own \u001b(B\u001b[0;1m\u001b[36m`README.md`\u001b[39m\u001b(B\u001b[m explaining exact\u001b(B\u001b[0;7m>\u001b[23;1H"]
[620.342546, "o", "\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**charter/**\u001b[39m\u001b(B\u001b[m — your project charter, business profi\u001b(B\u001b[0;7m>\u001b[24;1H\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**threat-model/**\u001b[39m\u001b(B\u001b[m — the threat model, versions 0 to\u001b(B\u001b[0;7m>\u001b[25;1H\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**architecture/**\u001b[39m\u001b(B\u001b[m — the Bicep design, identity mode\u001b(B\u001b[0;7m>\u001b[26;1H\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**infrastructure/**\u001b[39m\u001b(B\u001b[m — the OpenTofu definition and i\u001b(B\u001b[0;7m>\u001b[27;1H\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**hardening/**\u001b[39m\u001b(B\u001b[m — the Ansible playbook and Lynis bef\u001b(B\u001b[0;7m>\u001b[2;1H\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
